from sklearn.naive_bayes import GaussianNB
from sklearn.model_selection import GridSearchCV
import numpy as np

print("--- TRAINING NAIVE BAYES WITH CROSS-VALIDATION ---")

# 1. Initialize the base model
nb_cv_model = GaussianNB()

# 2. Define the hyperparameter grid
# var_smoothing defaults to 1e-9. We test a logarithmic range of values.
nb_param_grid = {
    'var_smoothing': np.logspace(-11, -5, 7) # Example: [1e-11, 1e-10, ..., 1e-5]
}

# 3. Set up GridSearchCV with 5 folds
nb_grid = GridSearchCV(
    estimator=nb_cv_model,
    param_grid=nb_param_grid,
    cv=5,
    scoring='accuracy',
    n_jobs=-1
)

# 4. Fit the Grid Search on training data
print("Running 5-Fold CV...")
nb_grid.fit(X_train_processed, y_train)

# 5. Extract the best model
best_nb = nb_grid.best_estimator_

print(f"Best Hyperparameters: {nb_grid.best_params_}")
print(f"Best CV Accuracy: {nb_grid.best_score_:.4f}")

# 6. Evaluate the best model on the validation set
nb_val_preds_cv = best_nb.predict(X_val_processed)
print(f"\nValidation Accuracy (Tuned): {accuracy_score(y_val, nb_val_preds_cv):.4f}")
